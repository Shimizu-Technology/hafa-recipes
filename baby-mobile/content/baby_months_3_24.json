{
  "batch": "baby-months-3-24",
  "approved": true,
  "_status": "Agent-reviewed 2026-11-07 by Leon’s decision for private family use. Not clinician-reviewed. Public/paid release requires clinician review and WHO chart permission.",
  "generated": "2026-11-05",
  "unit": "month",
  "note": {
    "text": "Babies develop at different rates. If you are worried or your baby loses a skill, ask your baby's doctor.",
    "source_url": "https://www.cdc.gov/act-early/milestones/2-months.html"
  },
  "periods": [
    {
      "age": 3,
      "items": [
        {
          "text": "Your baby may hold and shake hand toys.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-Birth-to-Three-Months.aspx"
        },
        {
          "text": "As arms and legs loosen up, your baby may look longer and leaner.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Physical-Appearance-and-Growth-1-To-3-Months.aspx"
        },
        {
          "text": "Held standing on your lap, your baby may discover bouncing.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-Birth-to-Three-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 4,
      "items": [
        {
          "text": "You may hear cooing: sounds like ooh and aah.",
          "source_url": "https://kidshealth.org/en/parents/development-4mos.html"
        },
        {
          "text": "Your baby may chuckle when you try to make them laugh.",
          "source_url": "https://kidshealth.org/en/parents/development-4mos.html"
        },
        {
          "text": "Babbling can begin about now, with a voice that rises and falls like talking.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Language-Development-4-to-7-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 5,
      "items": [
        {
          "text": "Your baby may rock on their tummy, kick and 'swim' with their arms.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-4-to-7-Months.aspx"
        },
        {
          "text": "On their back, your baby may grab their feet and bring them to their mouth.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-4-to-7-Months.aspx"
        },
        {
          "text": "Your baby is learning cause and effect, like a rattle making noise when it's shaken.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-4-to-7-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 6,
      "items": [
        {
          "text": "You may hear raspberries and squeals.",
          "source_url": "https://kidshealth.org/en/parents/development-6mos.html"
        },
        {
          "text": "Your baby may know familiar people and enjoy looking in a mirror.",
          "source_url": "https://kidshealth.org/en/parents/development-6mos.html"
        },
        {
          "text": "Your baby may reach for a toy and put things in their mouth to explore them.",
          "source_url": "https://kidshealth.org/en/parents/development-6mos.html"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 7,
      "items": [
        {
          "text": "Your baby may start copying the sounds you make.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Language-Development-4-to-7-Months.aspx"
        },
        {
          "text": "Your baby may drop things on purpose to see you pick them up.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-4-to-7-Months.aspx"
        },
        {
          "text": "Your baby may pass things from hand to hand.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-4-to-7-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 8,
      "items": [
        {
          "text": "Your baby may be curious about toys and enjoy exploring them.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-8-to-12-Months.aspx"
        },
        {
          "text": "If you hide a toy under a scarf, your baby may lift the scarf to look for it.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-8-to-12-Months.aspx"
        },
        {
          "text": "Crawling is usually mastered between 7 and 10 months. Some babies scoot instead, and a few never crawl.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-8-to-12-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 9,
      "items": [
        {
          "text": "You may hear sounds like ba-ba-ba and ma-ma-ma.",
          "source_url": "https://kidshealth.org/en/parents/development-9mos.html"
        },
        {
          "text": "Your baby may be shy or clingy around strangers.",
          "source_url": "https://kidshealth.org/en/parents/development-9mos.html"
        },
        {
          "text": "Your baby may lift their arms to be picked up.",
          "source_url": "https://kidshealth.org/en/parents/development-9mos.html"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 10,
      "items": [
        {
          "text": "By now your baby may keep looking for a toy they know is hidden.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-8-to-12-Months.aspx"
        },
        {
          "text": "Your baby may pull up to stand whenever they can, and may not yet know how to get down.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-8-to-12-Months.aspx"
        },
        {
          "text": "Your baby may point or gesture toward what they want.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Language-Development-8-to-12-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 11,
      "items": [
        {
          "text": "Your baby may walk along furniture, holding on.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Movement-8-to-12-Months.aspx"
        },
        {
          "text": "Your baby may copy the gestures you make when you talk.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Language-Development-8-to-12-Months.aspx"
        },
        {
          "text": "Your baby probably understands more than you'd guess, like looking toward a toy you mention.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Language-Development-8-to-12-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 12,
      "items": [
        {
          "text": "Your baby may pull up to stand and walk while holding on to furniture.",
          "source_url": "https://www.cdc.gov/act-early/milestones/1-year.html"
        },
        {
          "text": "Your baby may call a parent mama, dada or another special name.",
          "source_url": "https://www.cdc.gov/act-early/milestones/1-year.html"
        },
        {
          "text": "Your baby may start showing what things are for, like holding a toy phone to their ear.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/baby/Pages/Cognitive-Development-8-to-12-Months.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 13,
      "items": [
        {
          "text": "Your toddler may suddenly seem to understand much of what you say.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Language-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may swing between fierce independence and clinging to you.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Emotional-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may enjoy covering and uncovering boxes.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 14,
      "items": [
        {
          "text": "Your toddler may follow simple requests, like 'bring it to Mommy.'",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may point to show you what they need.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may be upset when you leave and need comfort when you return.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Emotional-Development-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 15,
      "items": [
        {
          "text": "Your toddler may try a word or two besides 'mama' and 'dada.'",
          "source_url": "https://kidshealth.org/en/parents/development-15mos.html"
        },
        {
          "text": "Your toddler may hug a stuffed toy and show you affection.",
          "source_url": "https://kidshealth.org/en/parents/development-15mos.html"
        },
        {
          "text": "Your toddler may take a few steps on their own.",
          "source_url": "https://kidshealth.org/en/parents/development-15mos.html"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 16,
      "items": [
        {
          "text": "Your toddler may start learning to walk backward, and up steps with help.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may enjoy being around other children, and copy them.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Social-Development-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 17,
      "items": [
        {
          "text": "Your toddler may enjoy turning knobs and pages.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may ask questions with one word, like 'Up?' or 'Out?'",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Language-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may scribble.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 18,
      "items": [
        {
          "text": "Your toddler may climb on a chair or couch without help.",
          "source_url": "https://kidshealth.org/en/parents/development-18mos.html"
        },
        {
          "text": "Your toddler may start to recognize themselves in the mirror.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Social-Development-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 19,
      "items": [
        {
          "text": "Your toddler may use a few action words, like 'go' and 'jump.'",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Language-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may name pictures of things and animals.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may help get undressed and put things away.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 20,
      "items": [
        {
          "text": "Your toddler may build a tower of up to four blocks, then knock it down.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may point to body parts when you name them.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may want to join in with whatever you're doing around the house.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Social-Development-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 21,
      "items": [
        {
          "text": "With you showing how, your toddler may try brushing teeth and washing hands.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Social-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may look for help when something goes wrong.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        },
        {
          "text": "Your toddler may start listening to stories with pictures.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 22,
      "items": [
        {
          "text": "Your toddler may stack five or six blocks.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may take toys apart and put them back together.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 23,
      "items": [
        {
          "text": "'Me' and 'you' may become favorite words.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Language-Development-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may tell you when they're thirsty or hungry.",
          "source_url": "https://medlineplus.gov/ency/article/002012.htm"
        },
        {
          "text": "Your toddler may try simple games of pretend.",
          "source_url": "https://medlineplus.gov/ency/article/002010.htm"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    },
    {
      "age": 24,
      "items": [
        {
          "text": "Your toddler may put two words together, like 'more milk.'",
          "source_url": "https://www.cdc.gov/act-early/milestones/2-years.html"
        },
        {
          "text": "Your toddler may start to favor one hand. Many children don't show a preference for years.",
          "source_url": "https://www.healthychildren.org/English/ages-stages/toddler/Pages/Hand-and-Finger-Skills-1-Year-Olds.aspx"
        },
        {
          "text": "Your toddler may kick a ball and run with better coordination.",
          "source_url": "https://medlineplus.gov/ency/article/002012.htm"
        }
      ],
      "review_status": "AGENT_REVIEWED_PRIVATE_FAMILY_2026-11-07"
    }
  ]
}
