{
  "cli": {
    "version": ">=19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_BABY_RELEASE_AUDIENCE": "private-family"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_BABY_RELEASE_AUDIENCE": "private-family"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_BABY_RELEASE_AUDIENCE": "public"
      }
    },
    "family": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_BABY_RELEASE_AUDIENCE": "private-family"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "4T358A5S74",
        "ascAppId": "6824692682"
      }
    }
  }
}
