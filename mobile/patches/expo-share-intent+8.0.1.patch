+        return pending.filter { value in
+            guard let key = key(value) else { return false }
+            HafaShareSaveIntent.recover(key, defaults: defaults, container: container)
+            return defaults.object(forKey: key) != nil && defaults.dictionary(forKey: "\(key).meta")?["confirmed"] as? Bool != false
+        }
+    }
+    static func deliveryURL(pending: [String], fallback: String, defaults: UserDefaults, container: URL) -> URL? {
+        if let first = deliverable(pending, defaults: defaults, container: container).first { return URL(string: first) }
