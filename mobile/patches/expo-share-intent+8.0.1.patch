+// HAFA_ATOMIC_CAPTURE_SNAPSHOT_BEGIN
+// This helper runs only inside the same flock transaction as payload lookup.
+// Its returned JSON contains the complete identity snapshot consumed by JS.
+enum HafaShareCaptureSnapshot {
+    static func key(_ value: String) -> String? { URL(string: value)?.host?.components(separatedBy: "=").last }
+    static func deliverable(_ pending: [String], defaults: UserDefaults, container: URL) -> [String] {
