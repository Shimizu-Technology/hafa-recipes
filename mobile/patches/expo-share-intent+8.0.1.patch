+        guard descriptor >= 0 else { return nil }
+        defer { close(descriptor) }
+        guard flock(descriptor, LOCK_EX) == 0 else { return nil }
+        defer { flock(descriptor, LOCK_UN) }
+        defaults.synchronize()
+        let result = operation(defaults, container)
+        defaults.synchronize()
+        return result
+    }
