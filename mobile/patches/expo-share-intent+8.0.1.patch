+            let payloadData = payloadJSON.data(using: .utf8),
+            var payload = (try? JSONSerialization.jsonObject(with: payloadData)) as? [String: Any]
+        else { return nil }
+        var metadata = defaults.dictionary(forKey: "\(captureKey).meta") ?? [
