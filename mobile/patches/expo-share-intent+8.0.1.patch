+    // The extension and containing app can update this queue at the same time.
+    // Lock the shared container before each read-modify-write transaction.
+    private func withLockedDefaults<T>(_ operation: (UserDefaults, URL) -> T) -> T? {
+        guard let appGroup = getAppGroupIdentifier(),
+            let container = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroup),
+            let defaults = UserDefaults(suiteName: appGroup)
