# Recipe Extractor Mobile - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# CLERK AUTH (required)
# Get from: Clerk Dashboard → API Keys → Publishable key
# ============================================
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional release guard. If set, it must match the publishable-key prefix.
# Bridge release: development. Final cutover release: production.
EXPO_PUBLIC_CLERK_ENVIRONMENT=development

# Optional local override. Production builds default to the Render API and
# reject non-HTTPS overrides. Useful for testing a local client against prod.
EXPO_PUBLIC_API_BASE_URL=https://recipe-api-x5na.onrender.com

# ============================================
# NOTE: For production builds
# Set EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY in:
# Expo Dashboard → Project Settings → Environment variables
# ============================================

# ============================================
# SENTRY ERROR MONITORING (optional but recommended)
# Get from: Sentry Dashboard → Project Settings → Client Keys (DSN)
# ============================================
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

