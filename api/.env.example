# Recipe Extractor API - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (required)
# ============================================
DATABASE_URL=postgresql://hafa:hafa_local_only@localhost:55432/hafa_recipes_development
DATABASE_USE_SSL=false
DATABASE_ECHO_SQL=false
# Exceptional escape hatch for a disposable non-production database only.
ALLOW_REMOTE_DATABASE_IN_DEVELOPMENT=false

# ============================================
# OPENAI (required)
# Used for pinned Luna/Terra recipe AI plus Whisper/TTS media features
# ============================================
OPENAI_API_KEY=local-ai-disabled
# Local paid calls are off by default. Enable only with a budget-limited
# development provider key; never place the production key in this file.
ALLOW_PAID_AI_IN_DEVELOPMENT=false

# Pinned AI capability registry (routine Luna, deterministic Terra fallback)
RECIPE_EXTRACTION_MODEL=gpt-5.6-luna
RECIPE_EXTRACTION_FALLBACK_MODEL=gpt-5.6-terra
OCR_MODEL=gpt-5.6-luna
OCR_FALLBACK_MODEL=gpt-5.6-terra
RECIPE_CHAT_MODEL=gpt-5.6-luna
COOKING_CHAT_MODEL=gpt-5.6-luna
ENRICHMENT_MODEL=gpt-5.6-luna
# Optional, deterministic per-capability canary rollout. Set a percentage back
# to 0 for immediate rollback. JSON keys: recipe_extraction, ocr, recipe_chat,
# cooking_chat, enrichment, transcription, tts.
AI_CANARY_MODELS={}
AI_CANARY_PERCENTAGES={}
# Token rates are explicit configuration so cost estimates never guess for an
# unknown model. Override this JSON when provider pricing changes.
AI_MODEL_PRICING={"gpt-5.6-luna":{"input_per_million":0.2,"cached_input_per_million":0.02,"output_per_million":1.2},"gpt-5.6-terra":{"input_per_million":2.0,"cached_input_per_million":0.2,"output_per_million":12.0}}
TRANSCRIPTION_MODEL=whisper-1
TTS_MODEL=tts-1
OPENAI_REASONING_EFFORT=none
# Emergency kill switch, e.g. recipe_chat,ocr or all
AI_DISABLED_CAPABILITIES=

# ============================================
# CLERK AUTH (required)
# During the bridge, configure both instances explicitly. Each issuer has its
# own verification policy and Backend API secret. Keep development primary
# until production users are provisioned and the production-key app is tested.
# ============================================
CLERK_DEVELOPMENT_ISSUER=https://your-development-instance.clerk.accounts.dev
CLERK_DEVELOPMENT_SECRET_KEY=sk_test_...
# CLERK_DEVELOPMENT_JWKS_URL=https://your-development-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_DEVELOPMENT_AUDIENCE=hafa-recipes-api
# CLERK_DEVELOPMENT_AUTHORIZED_PARTIES=https://hafa-recipes.com
# Native Clerk tokens may omit azp. Enable only for clients where azp is guaranteed.
# CLERK_DEVELOPMENT_REQUIRE_AUTHORIZED_PARTY=false

CLERK_PRODUCTION_ISSUER=https://clerk.hafa-recipes.com
CLERK_PRODUCTION_SECRET_KEY=sk_live_...
# CLERK_PRODUCTION_JWKS_URL=https://clerk.hafa-recipes.com/.well-known/jwks.json
# CLERK_PRODUCTION_AUDIENCE=hafa-recipes-api
# CLERK_PRODUCTION_AUTHORIZED_PARTIES=https://hafa-recipes.com
# CLERK_PRODUCTION_REQUIRE_AUTHORIZED_PARTY=false

CLERK_PRIMARY_ENVIRONMENT=development

# Backward-compatible single-instance settings. Keep these only until the
# explicit development settings above are deployed and verified.
# CLERK_FRONTEND_API=your-development-instance.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_ISSUER=https://your-development-instance.clerk.accounts.dev
# CLERK_JWT_AUDIENCE=hafa-recipes-api
# CLERK_AUTHORIZED_PARTIES=https://hafa-recipes.com

# ============================================
# AWS S3 (recommended)
# Used for: Permanent thumbnail storage
# Without this, thumbnails use temporary URLs that expire
# ============================================
# AWS_ACCESS_KEY_ID=replace-with-a-development-only-key
# AWS_SECRET_ACCESS_KEY=replace-with-a-development-only-secret
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=replace-with-a-development-only-bucket

# ============================================
# OPTIONAL
# ============================================
ENVIRONMENT=development
# Comma-separated browser origins. Defaults to * in development and hafa-recipes.com in non-development.
# CORS_ORIGINS=https://hafa-recipes.com,https://www.hafa-recipes.com
# ENABLE_SENTRY_DEBUG=false

# ============================================
# INSTAGRAM (optional)
# Required for Instagram video extraction
# ============================================
# Option 1: Paste raw cookie content (from cookies.txt export)
# INSTAGRAM_COOKIES=# Netscape HTTP Cookie File
# .instagram.com	TRUE	/	TRUE	...

# Option 2: Path to cookies file
# INSTAGRAM_COOKIES=/path/to/instagram_cookies.txt

# Expensive media request budgets
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_METADATA_TIMEOUT_SECONDS=30
VIDEO_MAX_DURATION_SECONDS=3600
AUDIO_MAX_BYTES=26214400

# Durable database-backed extraction worker.
# Apply migration 018 before enabling this in any deployed environment.
JOB_WORKER_ENABLED=true
JOB_WORKER_POLL_SECONDS=5
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
JOB_EXPIRY_HOURS=24
DELETION_CLEANUP_WORKER_ENABLED=true
DELETION_CLEANUP_POLL_SECONDS=10
DELETION_CLEANUP_LEASE_SECONDS=300
DELETION_CLEANUP_MAX_ATTEMPTS=20

# Facebook Graph API token for Instagram oEmbed (alternative to cookies)
# IG_OEMBED_TOKEN=your-facebook-graph-api-token


# ============================================
# SENTRY ERROR MONITORING (optional but recommended)
# Get DSN from: Sentry Dashboard → Project Settings → Client Keys
# Create a separate project for the backend (e.g., "hafa-recipes-api")
# ============================================
# Optional. Leave blank for local development.
SENTRY_DSN=
