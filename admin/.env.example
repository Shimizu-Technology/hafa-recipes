# Clerk browser key for the same Clerk instance trusted by the API.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Production uses https://recipe-api-x5na.onrender.com.
# Local development defaults to 127.0.0.1:8000 when this is omitted.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional PostHog analytics and privacy-masked Session Replay.
# Stays inactive unless VITE_PUBLIC_POSTHOG_KEY is set in production (or VITE_ENABLE_ANALYTICS_IN_DEV=true).
# VITE_PUBLIC_POSTHOG_KEY=phc_...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_ENABLE_ANALYTICS_IN_DEV=false
